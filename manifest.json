{
	"name": "ContainMarks",
	"description": "Securely open bookmarks in multi-account containers",
	"version": "1.0.1",
	"manifest_version": 2,

	"author": "Mikenrafter",
	"homepage_url": "https://gitlab.com/mikenrafter/ContainMarks",

	"permissions": [
		"tabs",
		"menus",
		"contextMenus",
		"bookmarks",
		"contextualIdentities",
		"cookies",
		"storage",
		"unlimitedStorage",
		"notifications"
	],

	"background": {
		"scripts": ["background.js"]
	},

	"icons": {
		"48": "icon.svg",
		"96": "icon.svg"
	},

	"browser_specific_settings": {
		"gecko": {
			"id": "bookmarks@container"
		}
	}
}
