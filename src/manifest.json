{
	"name": "ContainMarks",
	"description": "Natively and easily edit and open bookmarks in multi-account containers.",
	"version": "1.1.5",
	"manifest_version": 2,

	"author": "Mikenrafter",
	"homepage_url": "https://gitlab.com/mikenrafter/ContainMarks",

	"permissions": [
		"tabs",
		"menus",
		"contextMenus",
		"bookmarks",
		"contextualIdentities",
		"cookies",
		"storage",
		"unlimitedStorage",
		"notifications",
		"webNavigation",
		"webRequest",
		"webRequestBlocking",
		"management",
		"<all_urls>"
	],

	"background": {
		"scripts": ["background.js"]
	},

	"options_ui": {
		"page": "preferences/options.html",
		"open_in_tab": false,
		"browser_style": true
	},

	"icons": {
		"19":  "icons/icon.svg",
		"32":  "icons/icon.svg",
		"48":  "icons/icon.svg",
		"96":  "icons/icon.svg",
		"128": "icons/icon.svg"
	},
	
	"page_action": {
		"default_icon": {
			"19":  "icons/icon-mini.svg",
			"32":  "icons/icon-mini.svg",
			"48":  "icons/icon-mini.svg",
			"96":  "icons/icon-mini.svg",
			"128": "icons/icon-mini.svg"
		},
		"default_title": "Bookmark this URL inside this container."
	},

	"browser_specific_settings": {
		"gecko": {
			"id": "cont@bmarks",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	}
}
